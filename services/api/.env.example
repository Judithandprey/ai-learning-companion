# Supply secrets through your local shell/secret manager; never commit real values.
LC_DATABASE_URL=
LC_TEST_DATABASE_URL=
# The production module app stays fail-closed without a reviewed authenticator.
# These switches apply ONLY to services.api.local:create_local_app.
LC_ENABLE_LOCAL_TEST_AUTH=0
LC_LOCAL_TEST_TOKEN=
LC_IMPORT_SYNTHETIC_FIXTURE=0
