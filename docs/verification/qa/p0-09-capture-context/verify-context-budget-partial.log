"""Real corpus: exact greedy change points (oracle) probed at cp-1/cp/cp+1 with the real assembler."""
import json, sys, time, random
from collections import Counter
from vcommon import *
from services.learning.evaluate import FIXTURES
part, nparts = int(sys.argv[1]), int(sys.argv[2])
archive = FixtureArchive.load(FIXTURES)
index = RetrievalIndex(archive)
raw = json.loads((FIXTURES / "records.json").read_bytes())
raw_text = {(o["user_id"], o["event_id"]): o["text"].encode("utf-8") for o in raw["observations"]}
qs = [q["query"] for q in json.loads((FIXTURES / "queries.json").read_text())]
qs += [q["query"] for q in json.loads((FIXTURES / "dev_queries.json").read_text())]
cases = []
for q in qs:
    for mode in ("current", "history"):
        cases.append(({**q, "mode": mode}, 5))
for q in qs[:6] + [{"text": "basis"}, {"text": "basis physical arrow", "project_id": "algebra", "actor": "user"}]:
    for mode in ("current", "history"):
        cases.append(({**q, "mode": mode}, 100))
cases = cases[part::nparts]

def changepoints(full, fullsize):
    lo = next(M for M in range(1, 10**7) if env_size(full, M) <= M)
    pts = {lo - 1, lo, lo + 1}
    M = lo
    while M <= fullsize + 2:
        exp, fails = oracle(full, M)
        nxt = min([s for s in fails if s > M] + [10 ** len(str(M))])
        pts |= {nxt - 1, nxt, nxt + 1}
        M = nxt
    return lo, sorted(p for p in pts if p > 0)

viol = calls = 0; stat = Counter(); nb_cases = 0; maxitems = 0; t0 = time.time()
rng = random.Random(part)
for query, top_k in cases:
    full = assemble_context(archive, index, query, user_id=USER, top_k=top_k, max_bytes=10**8)
    hits = index.search(query, user_id=USER, top_k=top_k)["hits"]
    check_order(full, hits)
    for it in full["items"]:
        assert it["evidence"]["text"].encode("utf-8") == raw_text[(it["evidence"]["user_id"], it["evidence"]["event_id"])]
    stat[full["retrieval"]["status"]] += 1
    nb_cases += any(i["origin"] == "correction_neighbor" for i in full["items"])
    maxitems = max(maxitems, len(full["items"]))
    fullsize = len(enc(full))
    lo, pts = changepoints(full, fullsize)
    pts += [rng.randint(lo, fullsize + 10) for _ in range(5)] + [32767, 32768, 32769]
    for M in pts:
        exp, _ = oracle(full, M)
        calls += 1
        try:
            act = assemble_context(archive, index, query, user_id=USER, top_k=top_k, max_bytes=M)
        except ValueError:
            if exp is not None:
                viol += 1; print("VIOL unexpected ValueError", query, top_k, M)
            continue
        if exp is None or act != exp or len(canonical(act)) > M:
            viol += 1; print("VIOL", query, top_k, M)
print(f"part {part}: cases={len(cases)} calls={calls} viol={viol} statuses={dict(stat)} cases_with_neighbors={nb_cases} max_items={maxitems} {time.time()-t0:.0f}s")
EOF
