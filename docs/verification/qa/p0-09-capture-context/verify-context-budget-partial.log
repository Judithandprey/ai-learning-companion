"""max_bytes/top_k parameter edges."""
import enum, math, sys
from vcommon import *
from services.learning.evaluate import FIXTURES
archive = FixtureArchive.load(FIXTURES)
index = RetrievalIndex(archive)
Q = {"text": "basis physical arrow", "project_id": "algebra", "actor": "user"}
class IE(enum.IntEnum):
    A = 32768
def run(**kw):
    try:
        p = assemble_context(archive, index, Q, user_id=USER, **kw)
        return ("ok", len(p["items"]), p["budget"]["status"], p["budget"]["max_bytes"] if isinstance(p["budget"]["max_bytes"], int) and p["budget"]["max_bytes"] < 10**20 else f"<{len(str(p['budget']['max_bytes']))} digits>", len(canonical(p)))
    except Exception as e:
        return (type(e).__name__, str(e)[:80])
print("int_max_str_digits", sys.get_int_max_str_digits())
for label, v in [("True", True), ("False", False), ("0", 0), ("-1", -1), ("1.0", 1.0), ("32768.0", 32768.0), ("inf", math.inf),
                 ("nan", math.nan), ("'32768'", "32768"), ("None", None), ("IntEnum", IE.A), ("2**53-1", 2**53 - 1), ("2**53", 2**53),
                 ("2**63", 2**63), ("10**4299", 10**4299), ("10**4300", 10**4300)]:
    print("max_bytes", label, "->", run(max_bytes=v))
for label, v in [("True", True), ("0", 0), ("1", 1), ("100", 100), ("101", 101), ("5.0", 5.0), ("2**70", 2**70), ("IntEnum", IE.A)]:
    print("top_k", label, "->", run(top_k=v))
EOF
