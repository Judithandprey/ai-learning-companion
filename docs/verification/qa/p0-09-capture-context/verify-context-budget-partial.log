"""Greedy fill: superseded neighbor kept while its correction hit is omitted; temporal label."""
from vcommon import *
from services.learning.evaluate import FIXTURES
archive = FixtureArchive.load(FIXTURES)
index = RetrievalIndex(archive)
Q = {"text": "basis physical arrow", "project_id": "algebra", "actor": "user"}
full = assemble_context(archive, index, Q, user_id=USER, top_k=2, max_bytes=10**6)
print("full order:", [(i["evidence"]["event_id"], i["origin"], i["retrieval_rank"], i["snapshot_status"], len(canonical(i))) for i in full["items"]])
bad = []
for M in range(1000, len(canonical(full)) + 5):
    try:
        p = assemble_context(archive, index, Q, user_id=USER, top_k=2, max_bytes=M)
    except ValueError:
        continue
    ids = [i["evidence"]["event_id"] for i in p["items"]]
    if "e-02-u" in ids and "e-02-c" not in ids:
        bad.append((M, ids, p["budget"]))
print("budgets with superseded e-02-u present but correction e-02-c absent:", len(bad),
      "range", bad[0][0] if bad else None, "..", bad[-1][0] if bad else None)
if bad:
    M, ids, b = bad[0]
    print("first:", M, ids, b)
    p = assemble_context(archive, index, Q, user_id=USER, top_k=2, max_bytes=M)
    u = next(i for i in p["items"] if i["evidence"]["event_id"] == "e-02-u")
    print("e-02-u labels:", u["origin"], u["snapshot_status"], u["superseded_by_correction"], u["correction_relations"], u["correction_resolution"])
    print("interpretation.relation_references:", p["interpretation"]["relation_references"])
for q in ({"text": "basis", "mode": "history"}, {"text": "basis", "mode": "history", "before": "2030-01-01T00:00:00Z"},
          {"text": "basis"}, {"text": "basis", "before": "2030-01-01T00:00:00Z"}):
    print(q, "->", assemble_context(archive, index, q, user_id=USER)["temporal_semantics"])
EOF
