"""Every-integer max_bytes sweep on crafted multibyte/escape archives vs independent oracle."""
import sys, time
from vcommon import *

def run_case(archive, index, query, top_k, events_by_id, label):
    full = assemble_context(archive, index, query, user_id=USER, top_k=top_k, max_bytes=10**7)
    hits = index.search({**query, "mode": query.get("mode", "current")}, user_id=USER, top_k=top_k)["hits"]
    check_order(full, hits)
