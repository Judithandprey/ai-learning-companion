"""Independent oracle helpers for verify-context-budget (scratch only)."""
import json, sys, unicodedata
from copy import deepcopy
from pathlib import Path
HERE = Path(__file__).resolve().parents[1]
sys.path[:0] = [str(HERE), str(HERE / 'tests/evals')]
import services.learning.context as ctxmod
from services.learning.archive import FixtureArchive, canonical
from services.learning.context import assemble_context
from services.learning.retrieval import RetrievalIndex
from test_memory import tiny_bundle
assert ctxmod.__file__.startswith(str(HERE)), ctxmod.__file__
USER = "synthetic-learner"


def enc(p):
    # Independent restatement of the documented encoding (compact, sorted, UTF-8).
    return json.dumps(p, sort_keys=True, ensure_ascii=False, separators=(",", ":"), allow_nan=False).encode("utf-8")


def build(full, M, inc):
    n = full["budget"]["eligible_item_count"]
    R = full["retrieval"]["returned_hit_count"]
    p = {k: deepcopy(v) for k, v in full.items() if k not in ("items", "budget")}
    p["budget"] = {"max_bytes": M, "encoding": "canonical_utf8_json",
                   "status": "limited" if len(inc) < n else "complete_for_eligible_items",
                   "eligible_item_count": n, "included_item_count": len(inc),
                   "omitted_retrieval_items": R - sum(i["origin"] == "retrieval" for i in inc),
                   "omitted_correction_items": (n - R) - sum(i["origin"] == "correction_neighbor" for i in inc)}
    p["items"] = list(inc)
    return p


def oracle(full, M):
    """Return (expected packet or None for ValueError, failing trial sizes)."""
    if len(enc(build(full, M, []))) > M:
        return None, []
    inc, fails = [], []
    for it in full["items"]:
        s = len(enc(build(full, M, inc + [it])))
        if s <= M:
            inc.append(it)
        else:
            fails.append(s)
    return build(full, M, inc), fails


def env_size(full, M):
    return len(enc(build(full, M, [])))


def check_order(full, hits):
    items = full["items"]
    R = len(hits)
    assert [i["origin"] for i in items[:R]] == ["retrieval"] * R, "hits not first"
    assert [i["retrieval_rank"] for i in items[:R]] == list(range(1, R + 1))
    assert [i["evidence"]["event_id"] for i in items[:R]] == [h["event_id"] for h in hits]
    assert [i["retrieval_score"] for i in items[:R]] == [h["score"] for h in hits]
    nb = items[R:]
    assert all(i["origin"] == "correction_neighbor" and i["retrieval_rank"] is None and i["retrieval_score"] is None for i in nb)
    keys = [(i["evidence"]["user_id"], i["evidence"]["event_id"]) for i in nb]
    assert keys == sorted(keys), "neighbors not identity-sorted"
    assert len(set(keys)) == len(keys)


def crafted_bundle(extra=True):
    sources, frames, events, artifacts = tiny_bundle()
    by = {e["event_id"]: e for e in events}
    by["e-02-t"]["text"] = "basis 基底 λ 👩🏽‍🔬 é 한국어 — “quoted” " * 6
    by["e-02-u"]["text"] = 'basis arrow "q" \\ back\\slash \x00\x01\x1f\x7f    ﻿ end ' * 3
    by["e-02-u"]["confidence"] = 0
    by["e-02-c"]["text"] = unicodedata.normalize("NFD", "basis arrow café 한국어 Ångström ") * 4
    by["e-02-c"]["confidence"] = 0.37
    by["e-02-c"]["received_at"] = "2025-01-02T00:00:00Z"   # earlier than captured_at, kept verbatim
    by["e-02-a"]["text"] = "basis " + "🙂" * 200
    if extra:
        base = dict(by["e-02-u"])
        def add(eid, seq, text, actor="user", corr=None, t="2025-01-04T00:00:00Z", **kw):
            e = {**base, "event_id": eid, "device_sequence": seq, "text": text, "actor": actor,
                 "correction_of": corr, "captured_at": t, "frame_id": None, "media_position": None,
                 "gap_flags": ["missing_frame"], "confidence": 1.0}
            e.update(kw)
            events.append(e)
        add("x1", 101, "basis arrow short")
        add("x2", 102, "basis arrow " + "长" * 700, corr="x1", t="2025-01-04T01:00:00Z")
        add("x3", 103, "basis arrow tiny", corr="x2", t="2025-01-04T02:00:00Z")
        add("x4", 104, "basis vector " + "\\\"" * 300, actor="teacher")
        add("x5", 105, "basis ok", actor="teacher", corr="x4", t="2025-01-04T03:00:00Z")
        add("x6", 106, "basis ok branch 🙂", actor="teacher", corr="x4", t="2025-01-04T04:00:00Z")
        add("x7", 107, "basis unknown speaker  ", actor="unknown", received_at="2025-01-05T00:00:00.000000000001Z")
        add("x8", 108, "unrelated neighbor text", corr="x3", t="2025-01-04T05:00:00Z")
    return sources, frames, events, artifacts
