        except ValueError as e:
            nval += 1
            if exp is not None:
                nviol += 1; print("VIOL unexpected ValueError", label, M, e)
            continue
        if exp is None:
            nviol += 1; print("VIOL expected ValueError", label, M); continue
        b = canonical(act)
        if not (len(b) <= M and b == enc(act) and act == exp):

