"""Unencodable query/scope values: which error, and how much evidence is rehydrated first."""
import json, math
from vcommon import *
from services.learning.evaluate import FIXTURES
archive = FixtureArchive.load(FIXTURES)
index = RetrievalIndex(archive)
calls = {"n": 0}
real = archive.evidence
def counted(key):
    calls["n"] += 1
    return real(key)
archive.evidence = counted
cases = [
    ("lone surrogate text (from json.loads)", json.loads('{"text": "basis \\ud800 arrow"}'), USER),
    ("NaN source_version", {"text": "basis", "source_version": math.nan}, USER),
    ("inf source_version", {"text": "basis", "source_version": math.inf}, USER),
    ("set project_id", {"text": "basis", "project_id": {"algebra"}}, USER),
    ("bytes project_id", {"text": "basis", "project_id": b"algebra"}, USER),
    ("lone surrogate user_id", {"text": "basis"}, "user\ud800"),
    ("escape-heavy valid text", {"text": 'basis "q" \\   \x00 \x1f ﻿ 基底 👩🏽‍🔬'}, USER),
]
for label, q, uid in cases:
    calls["n"] = 0
    try:
        p = assemble_context(archive, index, q, user_id=uid, max_bytes=32768)
        print(f"{label}: ok items={len(p['items'])} size={len(canonical(p))} evidence_calls={calls['n']}")
    except Exception as e:
        print(f"{label}: {type(e).__name__} isinstance(ValueError)={isinstance(e, ValueError)} "
              f"msg={str(e)[:90]!r} evidence_calls_before_failure={calls['n']}")
EOF
