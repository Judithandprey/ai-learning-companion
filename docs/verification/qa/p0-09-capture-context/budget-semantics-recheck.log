## step2.py
import resource, time
from pathlib import Path
from services.learning.archive import FixtureArchive, canonical
from services.learning.retrieval import RetrievalIndex
from services.learning.context import assemble_context
def rss(): return resource.getrusage(resource.RUSAGE_SELF).ru_maxrss // 1024
archive = FixtureArchive.load(Path("tests/fixtures/memory")); index = RetrievalIndex(archive)
Q = {"text": "basis physical arrow", "project_id": "algebra", "actor": "user"}
full = assemble_context(archive, index, Q, user_id="synthetic-learner", top_k=2, max_bytes=10**6)
bad, t = [], time.perf_counter()
for M in range(1000, len(canonical(full)) + 5):
    try:
        p = assemble_context(archive, index, Q, user_id="synthetic-learner", top_k=2, max_bytes=M)
    except ValueError:
        continue
    items = {i["evidence"]["event_id"] for i in p["items"]}
    for i in p["items"]:
        kids = [r["event_id"] for r in i["correction_relations"] if r["direction"] == "corrected_by" and "event_id" in r]
        if i["superseded_by_correction"] and kids and not items.intersection(kids):
            bad.append((M, sorted(items), i["evidence"]["event_id"], kids, p["budget"]["status"], p["budget"]["omitted_retrieval_items"]))
    if M % 1000 == 0:
        print("M", M, f"{time.perf_counter()-t:.1f}s", rss(), "MB", flush=True)
print("superseded kept while its eligible correction omitted:", len(bad), "budgets; range", bad[0][0] if bad else None, "..", bad[-1][0] if bad else None, flush=True)
if bad: print("first:", bad[0], flush=True)
print("relation_references:", full["interpretation"]["relation_references"], flush=True)
