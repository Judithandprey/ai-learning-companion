TOOL cd /tmp/qa-27f/work/output-repair && cat > runner.py <<'EOF'
"""Failure-injection runner: run with cwd=<case>, PYTHONPATH=<case>. Only mutates COPIED originals."""
import os, signal, sys
from pathlib import Path
from services.learning import evaluate as e

mode, out = sys.argv[1], Path(sys.argv[2])
assert "/tmp/qa-27f/work/output-repair/" in str(e.FIXTURES), e.FIXTURES  # never the repo
write, real_hashes = e.write_output, e.hashes
state = {"summary_written": False}


def wrapped(path, value):
    n = path.name
    if mode == f"raise-before-{n}":
        raise OSError("injected before " + n)
    h = write(path, value)
    if n == "summary.json":
        state["summary_written"] = True
    act = mode.split("-after-")[0] if mode.endswith("-after-" + n) else None
    if act == "raise":
        raise OSError("injected after " + n)
    if act == "kbd":
        raise KeyboardInterrupt
    if act == "exit":
        os._exit(73)
    if act == "kill":
        os.kill(os.getpid(), signal.SIGKILL)
    if act == "term":
        os.kill(os.getpid(), signal.SIGTERM)
    if act == "sigint":
        os.kill(os.getpid(), signal.SIGINT)
    if act and act.startswith("mutate"):
        target = e.FIXTURES / sys.argv[3]
        with open(target, "ab") as f:  # copied original only
            f.write(b"\ninjected modification\n")
    return h


def hashes(root):
    if mode == "hashes-raise-final" and state["summary_written"]:
        raise OSError("injected final hash failure")
    return real_hashes(root)


e.write_output = wrapped
e.hashes = hashes
e.evaluate(out)
EOF
