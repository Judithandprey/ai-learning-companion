    same_other = {k: rc[k] == saved[k] for k in saved if k not in ("status", "preservation")}
    pres_other = {k: rc["preservation"][k] == saved["preservation"][k] for k in saved["preservation"] if k != "file_hashes_unchanged"}
    row = {"label": f"p3-{layout[:3]}-success", "exit": r.returncode, "stderr": last(r.stderr),
           "receipt_status": rc["status"], "receipt_fhu": rc["preservation"]["file_hashes_unchanged"],
           "receipt_fhu_before_pub": rc["preservation"]["file_hashes_unchanged_before_publication"],
           "run_ids_equal": rc["run_id"] == saved["run_id"] == rep["run_id"] == pre["run_id"],
           "summary_sha256_matches_bytes": rc["summary_sha256"] == hashlib.sha256(sb).hexdigest(),
           "artifact_hashes_match": {n: sha(out / n) == h for n, h in rc["artifact_hashes"].items()},
           "artifact_hash_names": sorted(rc["artifact_hashes"]),
           "saved_summary_status": saved["status"], "saved_summary_fhu": saved["preservation"]["file_hashes_unchanged"],
           "saved_report_fhu": rep["preservation"]["file_hashes_unchanged"], "saved_summary_has_summary_sha": "summary_sha256" in saved,
           "receipt_other_fields_equal_saved": all(same_other.values()), "receipt_other_preservation_equal": all(pres_other.values()),
           "preflight_fixture_count": len(pre["fixture_file_hashes"]), "changed_originals": diff(before, after),
           "false_trues_on_disk": false_trues(out), "stdout_is_single_json": r.stdout.strip().startswith("{") and r.stdout.strip().endswith("}")}
    result
