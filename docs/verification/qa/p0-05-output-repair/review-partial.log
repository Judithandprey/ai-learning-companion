    base, case, root, out = make_case(f"p4-{label}", "normal")
    before = inventory(case)
    r = sh(base_cmd(case, ["--output", out]) + " " + redirect, 300)
    after = inventory(case)
    rec({"label": f"p4-{label}", "shell_out": r.stdout[-200:].strip(), "stderr_tail": last(r.stderr, 2)[-300:],
         "summary": summary_state(out), "changed_originals": diff(before, after)})

# receipt appended to a fixture original via caller redirection (contrived trusted-caller misuse)
