"""QA output-repair probe helpers. Every probe works on a fresh copy under WORK."""
import hashlib, json, os, shlex, shutil, subprocess, time
from pathlib import Path

REPO = Path("/tmp/qa-27f/repo")
PY = str(REPO / ".venv/bin/python")
WORK = Path("/tmp/qa-27f/work/output-repair")
assert WORK.is_dir()


def make_case(label, layout="normal"):
    """layout normal: case/tests/fixtures/memory is a real copy.
    layout dirsymlink: case/tests/fixtures/memory -> <label>/originals/memory (copied)."""
    base = WORK / label
    if base.exists():
        shutil.rmtree(base)
    case = base / "case"
    (case / "tests/fixtures").mkdir(parents=True)
    for name in ("services", "packages"):
        shutil.copytree(REPO / name, case / name, ignore=shutil.ignore_patterns("__pycache__", ".venv"))
    shutil.copy(REPO / "pyproject.toml", case / "pyproject.toml")
    if layout == "normal":
        root = case / "tests/fixtures/memory"
        shutil.copytree(REPO / "tests/fixtures/memory", root)
    else:
        root = base / "originals/memory"
        shutil.copytree(REPO / "tests/fixtures/memory", root)
        (case / "tests/fixtures/memory").symlink_to(root, target_is_directory=True)
    out = base / "out"
    out.mkdir()
    inv = inventory(case)
    assert len(inv) == 187, len(inv)
    return base, case, root, out


def inventory(case):
    """sha256 of every original, following symlinks (files and dirs) to physical targets."""
    lit = case / "tests/fixtures/memory"
    result = {}
    for dirpath, dirs, files in os.walk(lit, followlinks=True):
        for f in files:
            p = Path(dirpath) / f
            real = os.path.realpath(p)
            st = os.stat(real)
            result[str(p.relative_to(lit))] = (hashlib.sha256(Path(real).read_bytes()).hexdigest(), real, st.st_ino)
    return result


def diff(before, after):
    changed = sorted(k for k in set(before) | set(after) if before.get(k, (None,))[0] != after.get(k, (None,))[0])
    return changed


def sh(cmd, timeout=600):
    """Run a bash command with the address-space bound; returns CompletedProcess."""
    full = f"ulimit -v 4000000; {cmd}"
    return subprocess.run(["bash", "-c", full], capture_output=True, text=True, timeout=timeout + 30)


def cli(case, *args, timeout=600, extra=""):
    argv = " ".join(shlex.quote(str(a)) for a in args)
    cmd = (f"cd {shlex.quote(str(case))} && PYTHONPATH={shlex.quote(str(case))} PYTHONDONTWRITEBYTECODE=1 "
           f"timeout {timeout} {PY} -m services.learning.evaluate {argv} {extra}")
    t = time.time()
    r = sh(cmd, timeout)
    r.elapsed = round(time.time() - t, 2)
    return r


def last(s, n=1):
    lines = [l for l in s.strip().splitlines() if l.strip()]
    return " | ".join(lines[-n:])


def sha(p):
    return hashlib.sha256(Path(p).read_bytes()).hexdigest()


def outlist(out):
    res = {}
    for p in sorted(Path(out).iterdir()):
        kind = "symlink" if p.is_symlink() else "fifo" if p.is_fifo() else "dir" if p.is_dir() else "sock" if p.is_socket() else "file"
        res[p.name] = kind
    return res
