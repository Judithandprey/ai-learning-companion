"""Probe 1: QA-L05-01 per-file symlink / hard link at the four output names, both layouts."""
import json, os, sys
sys.path.insert(0, "/tmp/qa-27f/work/output-repair")
from lib import *

NAMES = ("preflight.json", "report.json", "failures.json", "summary.json")
results = []


def seed_previous(case, out):
    r = cli(case, "--output", out)
    assert r.returncode == 0, r.stderr
    return {n: sha(out / n) for n in NAMES}


def probe(label, layout, links, kind, via="physical"):
    base, case, root, out = make_case(label, layout)
    prev = seed_previous(case, out)
    lit = case / "tests/fixtures/memory"
    for name, target in links.items():
        tpath = (root if via == "physical" else lit) / target
        (out / name).unlink()
        if kind == "symlink":
            (out / name).symlink_to(tpath)
        else:
            os.link(root / target, out / name)
    ino = {t: os.stat(root / t).st_ino for t in links.values()}
    before = inventory(case)
    r = cli(case, "--output", out)
    after = inventory(case)
    row = {"label": label, "layout": layout, "kind": kind, "via": via, "links": links, "exit": r.returncode,
           "stdout_empty": r.stdout == "", "stderr": last(r.stderr), "changed_originals": diff(before, after),
           "out": outlist(out)}
    if kind == "symlink":
        row["non_link_previous_outputs_unchanged"] = all(sha(out / n) == prev[n] for n in NAMES if n not in links)
        row["links_still_symlinks"] = all((out / n).is_symlink() for n in links)
    else:
        rc = json.loads(r.stdout) if r.returncode == 0 else None
        s_bytes = (out / "summary.json").read_bytes() if (out / "summary.json").exists() else None
        row["receipt_status"] = rc and rc["status"]
        row["receipt_fhu"] = rc and rc["preservation"]["file_hashes_unchanged"]
        if rc:
            saved = json.loads(s_bytes)
            row["run_id_match"] = rc["run_id"] == saved["run_id"]
            row["summary_sha_match"] = rc["summary_sha256"] == hashlib.sha256(s_bytes).hexdigest()
            row["artifact_hashes_match"] = all(sha(out / n) == h for n, h in rc["artifact_hashes"].items())
            row["saved_status"] = saved["status"]
        row["original_inode_unchanged"] = all(os.stat(root / t).st_ino == ino[t] for t in links.values())
        row["out_names_now_distinct_inode"] = all(os.stat(out / n).st_ino != ino[links[n]] for n in links)
    results.append(row)
    print(json.dumps(row))


for layout in ("dirsymlink", "normal"):
    L = layout[:3]
    probe(f"p1-{L}-orig-sym-report", layout, {"report.json": "records.json"}, "symlink")
    probe(f"p1-{L}-orig-hard-summary", layout, {"summary.json": "records.json"}, "hardlink")
    if layout == "dirsymlink":
        probe(f"p1-{L}-orig-sym-report-literal", layout, {"report.json": "records.json"}, "symlink", via="literal")
    for name in NAMES:
        probe(f"p1-{L}-sym-{name}", layout, {name: "records.json"}, "symlink")
        probe(f"p1-{L}-hard-{name}", layout, {name: "records.json"}, "hardlink")
    multi1 = {"report.json": "records.json", "failures.json": "labels.json", "summary.json": "queries.json", "preflight.json": "README.md"}
    multi2 = {"report.json": "records.json", "failures.json": "labels.json", "summary.json": "queries.json", "preflight.json": "manifest.json"}
    probe(f"p1-{L}-multi-sym-readme", layout, multi1, "symlink")
    probe(f"p1-{L}-multi-sym-manifest", layout, multi2, "symlink")
    probe(f"p1-{L}-multi-hard-readme", layout, multi1, "hardlink")
    probe(f"p1-{L}-multi-hard-manifest", layout, multi2, "hardlink")
    # only-leaf symlink but the other three are hard links -> symlink must veto the whole run before publication
    base, case, root, out = make_case(f"p1-{L}-mixed-hard-plus-sym", layout)
    prev = seed_previous(case, out)
    for n, t in (("preflight.json", "records.json"), ("report.json", "labels.json"), ("failures.json", "queries.json")):
        (out / n).unlink(); os.link(root / t, out / n)
    (out / "summary.json").unlink(); (out / "summary.json").symlink_to(root / "manifest.json")
    before = inventory(case); outs = {n: sha(out / n) for n in NAMES}
    r = cli(case, "--output", out)
    after = inventory(case)
    row = {"label": f"p1-{L}-mixed-hard-plus-sym", "exit": r.returncode, "stdout_empty": r.stdout == "",
           "stderr": last(r.stderr), "changed_originals": diff(before, after),
           "outputs_unchanged": outs == {n: sha(out / n) for n in NAMES}, "hardlinks_still_linked": all(
               os.stat(out / n).st_ino == os.stat(root / t).st_ino for n, t in (("preflight.json", "records.json"), ("report.json", "labels.json"), ("failures.json", "queries.json")))}
    results.append(row); print(json.dumps(row))

json.dump(results, open(WORK / "p1_results.json", "w"), indent=1)
bad = [r for r in results if r.get("changed_originals")]
print("ROWS", len(results), "ROWS_WITH_CHANGED_ORIGINALS", len(bad))
