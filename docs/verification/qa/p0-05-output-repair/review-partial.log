"""Probe 3: receipt contents and failure edges."""
import json, os, sys
sys.path.insert(0, "/tmp/qa-27f/work/output-repair")
from lib import *

NAMES = ("preflight.json", "report.json", "failures.json", "summary.json")
results = []


def false_trues(out):
    """Find any on-disk JSON claiming completion or final preservation true."""
    hits = []
    def walk(v, where, fname):
        if isinstance(v, dict):
            for k, x in v.items():
                if k == "file_hashes_unchanged" and x is True:
                    hits.append(f"{fname}:{where}.{k}=true")
                if k == "status" and x == "complete":
                    hits.append(f"{fname}:{where}.status=complete")
                walk(x, f"{where}.{k}", fname)
        elif isinstance(v, list):
            for i, x in enumerate(v):
                walk(x, f"{where}[{i}]", fname)
    for p in Path(out).iterdir():
        if p.is_file() and not p.name.startswith("."):
            try:
                walk(json.loads(p.read_bytes()), "", p.name)
            except ValueError:
                hits.append(f"{p.name}:unparseable")
    return hits


def run_ids(out):
    ids = {}
    for n in NAMES:
        p = out / n
        if p.exists():
            v = json.loads(p.read_bytes())
            ids[n] = v.get("run_id") if isinstance(v, dict) else "(list, no run_id)"
    return ids


# ---- successful receipts in both layouts, real CLI
for layout in ("dirsymlink", "normal"):
    base, case, root, out = make_case(f"p3-{layout[:3]}-success", layout)
