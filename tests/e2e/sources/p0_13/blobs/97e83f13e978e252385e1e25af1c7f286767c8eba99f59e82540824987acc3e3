def case(number, title, problem, steps, *, intent="explore", level="none", response="", channel="body", coverage="structured", **options):
    key = f"p{number:02d}"
    context = {"problem": key, "source_version": 1, "attempt_revision": 3, "intent_revision": 2, "preference_revision": 1}
    trace = []
    for sequence, (step_id, text, parent, branch, kind) in enumerate(steps, 1):
        trace.append({"id": step_id, "text": text, "parent": parent, "branch": branch,
                      "kind": kind, "device": "synthetic-tablet", "device_sequence": sequence})
    value = {"id": key, "title": title, "problem": {"text": problem, "source_language": "en"},
             "coverage": {"path": coverage, "has_gap": False, "reason_known": False}, "trace": trace,
             "control": {"input_mode": "WRITE", "intent": intent, "requested_steps": ["b"], "connected": True, "current": context},
             "preference": {"persistent_language": "en", "temporary_override": None},
             "learning_evidence": {"delivered_help": "none", "unseen_problem": False, "independent_work_observed": False},
             "candidate": {"channel": channel, "declared_level": level, "text": response, "context": deepcopy(context),
                           "step_refs": [s[0] for s in steps], "language": "en", "mastery_claim": "none", "diagnosis": None}}
    for field, update in options.items():
        value[field].update(update)
    CASES.append(value)
    return value


