def write():
    provenance = {"origin": "synthetic", "consent_scope": "test_only", "attribution": "Project-authored process-policy review documents; not user history.",
                  "specification_commit": SPEC, "fixture_version": "problem-solving-v1", "runtime_contract": "none; design fixtures only"}
    labels = {}
    for line in LABEL_ROWS.splitlines():
        key, violations, observed, reference, edges = line.split("|")
        acceptance, focus = FOCUS[key]
        labels[key] = {"expected_rule_violations": violations.split(",") if violations else [],
                       "observed_ids": observed.split(","), "reference_ids": reference.split(","),
                       "known_edges": [edge.split(">") for edge in edges.split(",")] if edges else [],
                       "acceptance": acceptance.split(","), "review_focus": focus,
                       "independent_semantic_review": "not_run"}
    for name, data in (("cases.json", {"provenance": provenance, "cases": CASES}), ("labels.json", labels)):
        (ROOT / name).write_text(json.dumps(data, indent=2, ensure_ascii=False) + "\n")
    files = {name: sha256((ROOT / name).read_bytes()).hexdigest() for name in ("cases.json", "labels.json", "author_cases.py")}
    (ROOT / "manifest.json").write_text(json.dumps({"provenance": provenance, "files": files}, indent=2) + "\n")
    print(json.dumps({"process_cases": len(CASES), "labels": len(labels)}))


if __name__ == "__main__":
    write()
