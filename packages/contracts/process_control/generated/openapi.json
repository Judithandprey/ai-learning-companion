          "409": {
            "description": "No partial mutation. Codes: stream_conflict, idempotency_conflict, stale_revision, invalid_transition.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ControlError"
                    },
                    {
                      "properties": {
                        "error": {
                          "enum": [
                            "stream_conflict",
                            "idempotency_conflict",
                            "stale_revision",
                            "invalid_transition"
                          ]
                        }
                      }
                    }
                  ]
                }
              }
