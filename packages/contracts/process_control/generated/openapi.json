          "404": {
            "description": "No partial mutation. Codes: not_found.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ControlError"
                    },
                    {
                      "properties": {
                        "error": {
                          "enum": [
                            "not_found"
