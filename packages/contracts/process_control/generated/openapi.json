{
  "openapi": "3.1.1",
  "info": {
    "title": "Process Stream Control",
    "version": "0.2.1",
    "description": "Additive control-only contract; original /v1 and capture 0.2.0 payloads stay frozen. No endpoint, device, capture or provider capability is established."
  },
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "servers": [
    {
      "url": "/",
      "description": "Same-origin API; local development binds loopback."
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/v2/process/streams": {
      "post": {
        "operationId": "registerProcessStream",
        "x-required-scope": "process:control",
        "x-required-capability": "process.control.v0.2.1",
        "description": "Trusted authenticated client only; current ownership, membership, generation and capability checks precede mutation AND replay. See README for required transactional invariants. No live server implementation is supplied.",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "responses": {
          "200": {
            "description": "Transaction-current owned control state, also on exact command replay. This is not capture or artifact preservation evidence.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StreamState"
                }
              }
            }
          },
          "401": {
            "description": "No partial mutation. Codes: unauthenticated.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ControlError"
                    },
                    {
                      "properties": {
                        "error": {
                          "enum": [
                            "unauthenticated"
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "403": {
            "description": "No partial mutation. Codes: forbidden, capability_required.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ControlError"
                    },
                    {
                      "properties": {
                        "error": {
                          "enum": [
                            "forbidden",
                            "capability_required"
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "description": "No partial mutation. Codes: not_found.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ControlError"
                    },
                    {
                      "properties": {
                        "error": {
                          "enum": [
                            "not_found"
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "409": {
            "description": "No partial mutation. Codes: stream_conflict, idempotency_conflict, stale_revision, invalid_transition.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ControlError"
                    },
                    {
                      "properties": {
                        "error": {
                          "enum": [
                            "stream_conflict",
                            "idempotency_conflict",
                            "stale_revision",
                            "invalid_transition"
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "422": {
            "description": "No partial mutation. Codes: unsupported_version, invalid_request.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ControlError"
                    },
                    {
                      "properties": {
                        "error": {
                          "enum": [
                            "unsupported_version",
                            "invalid_request"
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "503": {
            "description": "No partial mutation. Codes: unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ControlError"
                    },
                    {
                      "properties": {
                        "error": {
                          "enum": [
                            "unavailable"
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StreamRegistration"
              }
            }
          }
        }
      }
    },
