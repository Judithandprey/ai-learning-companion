{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learning-companion.invalid/contracts/macos-capture-ingress/0.2.12",
  "$ref": "#/$defs/MacOSFrameBatchRequest",
  "$defs": {
    "ProcessVersion": {
      "const": "0.2.0"
    },
    "ArtifactReference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/Identifier"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        },
        "byte_length": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "media_type": {
          "enum": [
            "image/png",
            "image/jpeg",
            "image/svg+xml",
            "application/json",
            "text/plain"
          ]
        }
      },
      "required": [
        "artifact_id",
        "sha256",
        "byte_length",
        "media_type"
      ]
    },
    "ProvisionalScope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "provisional_session"
        }
      },
      "required": [
        "kind"
      ]
    },
    "AttemptScope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "attempt"
        },
        "problem_id": {
          "$ref": "#/$defs/Identifier"
        },
        "attempt_id": {
          "$ref": "#/$defs/Identifier"
        },
        "relation_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "kind",
        "problem_id",
        "attempt_id",
        "relation_revision"
      ]
    },
    "ProcessScope": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProvisionalScope"
        },
        {
          "$ref": "#/$defs/AttemptScope"
        }
      ]
    },
    "CaptureClock": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "domain_id": {
          "$ref": "#/$defs/Identifier"
        },
        "elapsed_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "uncertainty_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "domain_id",
        "elapsed_ms",
        "uncertainty_ms"
      ]
    },
    "UnknownState": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "unknown"
        },
        "reason": {
          "enum": [
            "not_observed",
            "ambiguous",
            "unavailable"
          ]
        }
      },
      "required": [
        "kind",
        "reason"
      ]
    },
    "TextState": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "text"
        },
        "text": {
          "type": "string",
          "maxLength": 100000
        }
      },
      "required": [
        "kind",
        "text"
      ]
    },
    "ChoiceState": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "choices"
        },
        "selected_option_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "uniqueItems": true,
          "maxItems": 100
        }
      },
      "required": [
        "kind",
        "selected_option_ids"
      ]
    },
    "ArtifactState": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "artifact"
        },
        "artifact_id": {
          "$ref": "#/$defs/Identifier"
        }
      },
      "required": [
        "kind",
        "artifact_id"
      ]
    },
    "ObservedState": {
      "anyOf": [
        {
          "$ref": "#/$defs/UnknownState"
        },
        {
          "$ref": "#/$defs/TextState"
        },
        {
          "$ref": "#/$defs/ChoiceState"
        },
        {
          "$ref": "#/$defs/ArtifactState"
        }
      ]
    },
    "OperationEvidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "operation"
        },
        "operation": {
          "enum": [
            "select",
            "deselect",
            "reselect",
            "text_edit",
            "ink_edit",
            "erase",
            "undo",
            "redo",
            "visible_change",
            "site_feedback"
          ]
        },
        "observed_actor": {
          "enum": [
            "user",
            "website",
            "ai",
            "unknown"
          ]
        },
        "actor_basis": {
          "enum": [
            "trusted_input_event",
            "script_observation",
            "visual_observation",
            "user_report",
            "unknown"
          ]
        },
        "before": {
          "$ref": "#/$defs/ObservedState"
        },
        "after": {
          "$ref": "#/$defs/ObservedState"
        },
        "reason_quote": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 10000
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "operation",
        "observed_actor",
        "actor_basis",
        "before",
        "after",
        "reason_quote"
      ]
    },
    "SequenceInterval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "first": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "last": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "first",
        "last"
      ]
    },
    "CoverageEvidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "coverage"
        },
        "coverage": {
          "enum": [
            "observed_samples",
            "partial",
            "unobserved",
            "unknown"
          ]
        },
        "from_clock_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "through_clock_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "missing_sequences": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SequenceInterval"
          },
          "maxItems": 100
        },
        "limitations": {
          "type": "array",
          "items": {
            "enum": [
              "sample_only",
              "disconnected",
              "missing_events",
              "blurred",
              "occluded",
              "unsupported_history",
              "unknown"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "kind",
        "coverage",
        "from_clock_ms",
        "through_clock_ms",
        "missing_sequences",
        "limitations"
      ]
    },
    "ProcessRecord": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "record_id": {
          "$ref": "#/$defs/Identifier"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "source": {
          "$ref": "#/$defs/SourceRef"
        },
        "scope": {
          "$ref": "#/$defs/ProcessScope"
        },
        "observed_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/UtcTimestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "clock": {
          "anyOf": [
            {
              "$ref": "#/$defs/CaptureClock"
            },
            {
              "type": "null"
            }
          ]
        },
        "media_position": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "surface": {
          "enum": [
            "web_dom",
            "web_canvas",
            "external_app",
            "original_screen_overlay",
            "owned_canvas",
            "frozen_capture",
            "side_by_side"
          ]
        },
        "method": {
          "enum": [
            "structured",
            "visual",
            "mixed"
          ]
        },
        "causal_parents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "uniqueItems": true,
          "maxItems": 100
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ArtifactReference"
          },
          "maxItems": 100
        },
        "evidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/OperationEvidence"
            },
            {
              "$ref": "#/$defs/CoverageEvidence"
            }
          ]
        },
        "frame_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "record_id",
        "sequence",
        "source",
        "scope",
        "observed_at",
        "clock",
        "media_position",
        "surface",
        "method",
        "causal_parents",
        "artifacts",
        "evidence",
        "frame_id"
      ]
    },
    "ProcessBatch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "$ref": "#/$defs/ProcessVersion"
        },
        "batch_id": {
          "$ref": "#/$defs/Identifier"
        },
        "device_id": {
          "$ref": "#/$defs/Identifier"
        },
        "session_id": {
          "$ref": "#/$defs/Identifier"
        },
        "stream_id": {
          "$ref": "#/$defs/Identifier"
        },
        "delivery_mode": {
          "enum": [
            "live",
            "historical"
          ]
        },
        "records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProcessRecord"
          },
          "minItems": 1,
          "maxItems": 100
        }
      },
      "required": [
        "contract_version",
        "batch_id",
        "device_id",
        "session_id",
        "stream_id",
        "delivery_mode",
        "records"
      ]
    },
    "ArtifactReceipt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/Identifier"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        },
        "byte_length": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "media_type": {
          "enum": [
            "image/png",
            "image/jpeg",
            "image/svg+xml",
            "application/json",
            "text/plain"
          ]
        },
        "status": {
          "enum": [
            "pending",
            "verified"
          ]
        }
      },
      "required": [
        "artifact_id",
        "sha256",
        "byte_length",
        "media_type",
        "status"
      ]
    },
    "ProcessReceipt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "record_id": {
          "$ref": "#/$defs/Identifier"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "disposition": {
          "enum": [
            "accepted",
            "duplicate"
          ]
        },
        "received_at": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "envelope": {
          "const": "committed"
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ArtifactReceipt"
          },
          "maxItems": 100
        }
      },
      "required": [
        "record_id",
        "sequence",
        "disposition",
        "received_at",
        "envelope",
        "artifacts"
      ]
    },
    "ProcessBatchAck": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "$ref": "#/$defs/ProcessVersion"
        },
        "batch_id": {
          "$ref": "#/$defs/Identifier"
        },
        "user_id": {
          "$ref": "#/$defs/Identifier"
        },
        "device_id": {
          "$ref": "#/$defs/Identifier"
        },
        "session_id": {
          "$ref": "#/$defs/Identifier"
        },
        "stream_id": {
          "$ref": "#/$defs/Identifier"
        },
        "acknowledged": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProcessReceipt"
          },
          "minItems": 1,
          "maxItems": 100
        }
      },
      "required": [
        "contract_version",
        "batch_id",
        "user_id",
        "device_id",
        "session_id",
        "stream_id",
        "acknowledged"
      ]
    },
    "ProcessError": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "$ref": "#/$defs/ProcessVersion"
        },
        "error": {
          "enum": [
            "unauthenticated",
            "forbidden",
            "capability_required",
            "not_found",
            "record_conflict",
            "idempotency_conflict",
            "dependency_missing",
            "stale_scope",
            "capture_stopped",
            "unsupported_version",
            "invalid_request",
            "unavailable"
          ]
        },
        "request_id": {
          "$ref": "#/$defs/Identifier"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "contract_version",
        "error",
        "request_id",
        "retryable"
      ]
    },
    "Identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*(?![\\s\\S])"
    },
    "UtcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z(?![\\s\\S])"
    },
    "SourceRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "user_id": {
          "$ref": "#/$defs/Identifier"
        },
        "source_id": {
          "$ref": "#/$defs/Identifier"
        },
        "source_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "user_id",
        "source_id",
        "source_version"
      ]
    },
    "IdempotencyKey": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}(?![\\s\\S])",
      "minLength": 1,
      "maxLength": 128
    },
    "PngArtifactReference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/Identifier"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        },
        "byte_length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 33554432
        },
        "media_type": {
          "const": "image/png"
        }
      },
      "required": [
        "artifact_id",
        "sha256",
        "byte_length",
        "media_type"
      ]
    },
    "NativeWallUtc": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,3})?Z(?![\\s\\S])"
    },
    "UInt64Decimal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20,
      "pattern": "^(?:0|[1-9][0-9]{0,18}|18446744073709551615|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4][0-9]{0})(?![\\s\\S])"
    },
    "ReportedRect": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number",
          "minimum": 0
        },
        "height": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ]
    },
    "MacDisplayAtStart": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "display_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "name": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1024
        },
        "frame_points": {
          "$ref": "#/$defs/ReportedRect"
        },
        "point_pixel_scale": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "requested_width_pixels": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "requested_height_pixels": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "rotation_degrees": {
          "type": "number"
        },
        "is_main": {
          "type": "boolean"
        },
        "scope": {
          "enum": [
            "whole display; no window excluded, so this app's windows are captured when visible; cursor shown; BGRA buffers requested in sRGB; no audio",
            "whole display; no window excluded, so this app's windows are captured when visible; cursor hidden; BGRA buffers requested in sRGB; no audio",
            "synthetic fixture; not a captured display",
            "whole display, SCContentFilter(display:excludingApplications: [this app], exceptingWindows: []); every window of this app (main window, ink overlay, palette, menu bar item, menus and alerts) is excluded, as far as ScreenCaptureKit's documented application exclusion applies, including to windows it creates after the filter (unverified on a Mac); all other applications' windows on the display are included; cursor shown; BGRA buffers requested in sRGB; no audio",
            "whole display, SCContentFilter(display:excludingApplications: [this app], exceptingWindows: []); every window of this app (main window, ink overlay, palette, menu bar item, menus and alerts) is excluded, as far as ScreenCaptureKit's documented application exclusion applies, including to windows it creates after the filter (unverified on a Mac); all other applications' windows on the display are included; cursor hidden; BGRA buffers requested in sRGB; no audio",
            "whole display, SCContentFilter(display:excludingWindows: []) with no window excluded; this app's ink overlay and palette panels request NSWindow.SharingType.none, which Apple calls legacy and says not to rely on to omit content, so whether kept frames contain them is unknown; this app's other windows are not excluded; cursor shown; BGRA buffers requested in sRGB; no audio",
            "whole display, SCContentFilter(display:excludingWindows: []) with no window excluded; this app's ink overlay and palette panels request NSWindow.SharingType.none, which Apple calls legacy and says not to rely on to omit content, so whether kept frames contain them is unknown; this app's other windows are not excluded; cursor hidden; BGRA buffers requested in sRGB; no audio"
          ]
        }
      },
      "required": [
        "display_id",
        "name",
        "frame_points",
        "point_pixel_scale",
        "requested_width_pixels",
        "requested_height_pixels",
        "rotation_degrees",
        "is_main",
        "scope"
      ]
    },
    "MacHostClock": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "basis": {
          "const": "mach_absolute_time_seconds"
        },
        "session_started_wall_utc": {
          "$ref": "#/$defs/NativeWallUtc"
        },
        "session_started_seconds": {
          "type": "number",
          "minimum": 0
        },
        "callback_seconds": {
          "type": "number",
          "minimum": 0
        },
        "display_time_ticks_decimal": {
          "anyOf": [
            {
              "$ref": "#/$defs/UInt64Decimal"
            },
            {
              "type": "null"
            }
          ]
        },
        "display_time_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "source_seconds": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "source_time_lead_tolerance_seconds": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "basis",
        "session_started_wall_utc",
        "session_started_seconds",
        "callback_seconds",
        "display_time_ticks_decimal",
        "display_time_seconds",
        "source_seconds",
        "source_time_lead_tolerance_seconds"
      ]
    },
    "MacSampleFacts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "complete"
        },
        "presentation_time_seconds": {
          "type": [
            "number",
            "null"
          ]
        },
        "geometry_basis": {
          "const": "SCStreamFrameInfo_as_reported"
        },
        "geometry_unit": {
          "type": "null"
        },
        "content_rect": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReportedRect"
            },
            {
              "type": "null"
            }
          ]
        },
        "content_scale": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "scale_factor": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "dirty_rects": {
          "anyOf": [
            {
              "type": "array",
              "maxItems": 4096,
              "items": {
                "$ref": "#/$defs/ReportedRect"
              }
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "status",
        "presentation_time_seconds",
        "geometry_basis",
        "geometry_unit",
        "content_rect",
        "content_scale",
        "scale_factor",
        "dirty_rects"
      ]
    },
    "MacPng": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "$ref": "#/$defs/PngArtifactReference"
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "native_file": {
          "type": "string",
          "pattern": "^(?:frames|composed)/[0-9]{8,16}\\.png(?![\\s\\S])"
        },
        "encoding": {
          "const": "png; 8-bit RGBA; sRGB; lossless; native size; not rotated"
        }
      },
      "required": [
        "artifact",
        "width",
        "height",
        "native_file",
        "encoding"
      ]
    },
    "MacInkDocumentReference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "created_in_session": {
          "$ref": "#/$defs/Identifier"
        },
        "file": {
          "type": "string",
          "maxLength": 512,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*/ink/ink(?:\\.conflict-[A-Za-z0-9-]+)?\\.json(?![\\s\\S])"
        },
        "display_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      },
      "required": [
        "created_in_session",
        "file",
        "display_id"
      ]
    },
    "MacPairedInk": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pixels_host_seconds": {
          "type": "number",
          "minimum": 0
        },
        "pixels_time": {
          "enum": [
            "source_time",
            "callback_admission"
          ]
        },
        "document": {
          "anyOf": [
            {
              "$ref": "#/$defs/MacInkDocumentReference"
            },
            {
              "type": "null"
            }
          ]
        },
        "revision": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "revision_host_seconds": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "strokes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "uniqueItems": true
        },
        "mapping": {
          "type": "string",
          "maxLength": 1024,
          "pattern": "^display-local points scaled by frame size / display size in points \\(([0-9]+(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?) \u00d7 ([0-9]+(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?)\\); contentRect and scaleFactor are not applied; unverified on a Mac(?![\\s\\S])"
        },
        "rendering": {
          "const": "sRGB (255, 59, 48); each stroke's own width in points, scaled like the point-to-pixel mapping; round caps and joins; antialiased; strokes in creation order; a one-point stroke as a dot"
        },
        "limits": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384
          },
          "minItems": 3
        }
      },
      "required": [
        "pixels_host_seconds",
        "pixels_time",
        "document",
        "revision",
        "revision_host_seconds",
        "strokes",
        "mapping",
        "rendering",
        "limits"
      ]
    },
    "MacComposed": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "composed"
        },
        "image": {
          "$ref": "#/$defs/MacPng"
        },
        "raw_sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "raw_file": {
          "type": "string",
          "pattern": "^frames/[0-9]{8,16}\\.png(?![\\s\\S])"
        },
        "raw_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        },
        "raw_byte_length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 33554432
        },
        "ink": {
          "$ref": "#/$defs/MacPairedInk"
        },
        "composed_host_seconds": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "kind",
        "image",
        "raw_sequence",
        "raw_file",
        "raw_sha256",
        "raw_byte_length",
        "ink",
        "composed_host_seconds"
      ]
    },
    "MacNotComposed": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "not_composed"
        },
        "callback_sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "host_seconds": {
          "type": "number",
          "minimum": 0
        },
        "reason": {
          "enum": [
            "refused",
            "raw_unavailable",
            "render_failed",
            "write_failed",
            "composed_cap_reached",
            "composed_store_stopped",
            "session_ended_before_composition"
          ]
        },
        "detail": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        }
      },
      "required": [
        "kind",
        "callback_sequence",
        "host_seconds",
        "reason",
        "detail"
      ]
    },
    "MacCompositionUnknown": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "unknown"
        },
        "reason": {
          "const": "no_retained_outcome"
        }
      },
      "required": [
        "kind",
        "reason"
      ]
    },
    "MacRetainedProfile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "macos_screencapturekit"
