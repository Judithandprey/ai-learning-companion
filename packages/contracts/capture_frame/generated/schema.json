{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learning-companion.invalid/contracts/capture-frame/0.2.5",
  "$ref": "#/$defs/RawCaptureFrame",
  "$defs": {
    "Identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*(?![\\s\\S])"
    },
    "UtcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z(?![\\s\\S])"
    },
    "SourceRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "user_id": {
          "$ref": "#/$defs/Identifier"
        },
        "source_id": {
          "$ref": "#/$defs/Identifier"
        },
        "source_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "user_id",
        "source_id",
        "source_version"
      ]
    },
    "PngArtifactReference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/Identifier"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        },
        "byte_length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 33554432
        },
        "media_type": {
          "const": "image/png"
        }
      },
      "required": [
        "artifact_id",
        "sha256",
        "byte_length",
        "media_type"
      ]
    },
    "CallbackClock": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "domain_id": {
          "$ref": "#/$defs/Identifier"
        },
        "elapsed_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "uncertainty_ms": {
          "type": "null"
        }
      },
      "required": [
        "domain_id",
        "elapsed_ms",
        "uncertainty_ms"
      ]
    },
    "RawCaptureTiming": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "observed_at_estimate": {
              "type": "null"
            },
            "estimate_basis": {
              "type": "null"
            },
            "uncertainty_ms": {
              "type": "null"
            },
            "callback_clock": {
              "anyOf": [
                {
                  "$ref": "#/$defs/CallbackClock"
                },
                {
                  "type": "null"
                }
              ]
            },
            "sample_pts_seconds": {
              "type": [
                "number",
                "null"
              ]
            }
          },
          "required": [
            "observed_at_estimate",
            "estimate_basis",
            "uncertainty_ms",
            "callback_clock",
            "sample_pts_seconds"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "observed_at_estimate": {
              "$ref": "#/$defs/UtcTimestamp"
            },
            "estimate_basis": {
              "const": "session_wall_plus_callback_monotonic_delta"
            },
            "uncertainty_ms": {
              "type": "null"
            },
            "callback_clock": {
              "$ref": "#/$defs/CallbackClock"
            },
            "sample_pts_seconds": {
              "type": [
                "number",
                "null"
              ]
            }
          },
          "required": [
            "observed_at_estimate",
            "estimate_basis",
            "uncertainty_ms",
            "callback_clock",
            "sample_pts_seconds"
          ]
        }
      ]
    },
    "RawCaptureOrientation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "system": {
          "const": "CGImagePropertyOrientation"
        },
        "value": {
          "type": [
            "integer",
            "null"
          ],
          "enum": [
            null,
            1,
            2,
            3,
            4,
            5,
            6,
            7,
            8
          ]
        },
        "applied_to_pixels": {
          "type": "boolean",
          "const": false
        }
      },
      "required": [
        "system",
        "value",
        "applied_to_pixels"
      ]
    },
    "RawCaptureFrame": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "0.2.5"
        },
        "kind": {
          "const": "raw_capture_frame"
        },
        "frame_id": {
          "$ref": "#/$defs/Identifier"
        },
        "source": {
          "$ref": "#/$defs/SourceRef"
        },
        "device_id": {
          "$ref": "#/$defs/Identifier"
        },
        "session_id": {
          "$ref": "#/$defs/Identifier"
        },
        "stream_id": {
          "$ref": "#/$defs/Identifier"
        },
        "artifact": {
          "$ref": "#/$defs/PngArtifactReference"
        },
        "raw_width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "raw_height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "buffer_sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "captured_at": {
          "type": "null"
        },
        "media_position": {
          "type": "null"
        },
        "timing": {
          "$ref": "#/$defs/RawCaptureTiming"
        },
        "orientation": {
          "$ref": "#/$defs/RawCaptureOrientation"
        }
      },
      "required": [
        "contract_version",
        "kind",
        "frame_id",
        "source",
        "device_id",
        "session_id",
        "stream_id",
        "artifact",
        "raw_width",
        "raw_height",
        "buffer_sequence",
        "captured_at",
        "media_position",
        "timing",
        "orientation"
      ]
    }
  }
}
