{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learning-companion.invalid/contracts/desktop-frame/0.2.7",
  "$ref": "#/$defs/DesktopFrame",
  "$defs": {
    "Identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*(?![\\s\\S])"
    },
    "UtcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z(?![\\s\\S])"
    },
    "SourceRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "user_id": {
          "$ref": "#/$defs/Identifier"
        },
        "source_id": {
          "$ref": "#/$defs/Identifier"
        },
        "source_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "user_id",
        "source_id",
        "source_version"
      ]
    },
    "PngArtifactReference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/Identifier"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        },
        "byte_length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 33554432
        },
        "media_type": {
          "const": "image/png"
        }
      },
      "required": [
        "artifact_id",
        "sha256",
        "byte_length",
        "media_type"
      ]
    },
    "NativeWallUtc": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,3})?Z(?![\\s\\S])"
    },
    "CallbackEstimateUtc": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z(?![\\s\\S])"
    },
    "UInt64Decimal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20,
      "pattern": "^(?:0|[1-9][0-9]{0,18}|18446744073709551615|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4][0-9]{0})(?![\\s\\S])"
    },
    "ReportedRect": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number",
          "minimum": 0
        },
        "height": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ]
    },
    "MacDisplayAtStart": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "display_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "name": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1024
        },
        "frame_points": {
          "$ref": "#/$defs/ReportedRect"
        },
        "point_pixel_scale": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "requested_width_pixels": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "requested_height_pixels": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "rotation_degrees": {
          "type": "number"
        },
        "is_main": {
          "type": "boolean"
        },
        "scope": {
          "enum": [
            "whole display; no window excluded, so this app's windows are captured when visible; cursor shown; BGRA buffers requested in sRGB; no audio",
            "whole display; no window excluded, so this app's windows are captured when visible; cursor hidden; BGRA buffers requested in sRGB; no audio",
            "synthetic fixture; not a captured display"
          ]
        }
      },
      "required": [
        "display_id",
        "name",
        "frame_points",
        "point_pixel_scale",
        "requested_width_pixels",
        "requested_height_pixels",
        "rotation_degrees",
        "is_main",
        "scope"
      ]
    },
    "MacHostClock": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "basis": {
          "const": "mach_absolute_time_seconds"
        },
        "session_started_wall_utc": {
          "$ref": "#/$defs/NativeWallUtc"
        },
        "session_started_seconds": {
          "type": "number",
          "minimum": 0
        },
        "callback_seconds": {
          "type": "number",
          "minimum": 0
        },
        "display_time_ticks_decimal": {
          "anyOf": [
            {
              "$ref": "#/$defs/UInt64Decimal"
            },
            {
              "type": "null"
            }
          ]
        },
        "display_time_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      },
      "required": [
        "basis",
        "session_started_wall_utc",
        "session_started_seconds",
        "callback_seconds",
        "display_time_ticks_decimal",
        "display_time_seconds"
      ]
    },
    "MacSampleFacts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "complete"
        },
        "presentation_time_seconds": {
          "type": [
            "number",
            "null"
          ]
        },
        "geometry_basis": {
          "const": "SCStreamFrameInfo_as_reported"
        },
        "geometry_unit": {
          "type": "null"
        },
        "content_rect": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReportedRect"
            },
            {
              "type": "null"
            }
          ]
        },
        "content_scale": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "scale_factor": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "dirty_rects": {
          "anyOf": [
            {
              "type": "array",
              "maxItems": 4096,
              "items": {
                "$ref": "#/$defs/ReportedRect"
              }
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "status",
        "presentation_time_seconds",
        "geometry_basis",
        "geometry_unit",
        "content_rect",
        "content_scale",
        "scale_factor",
        "dirty_rects"
      ]
    },
    "MacScreenCaptureKit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "macos_screencapturekit"
        },
        "native_session_id": {
          "$ref": "#/$defs/Identifier"
        },
        "pixel_format": {
          "type": "string",
          "minLength": 4,
          "maxLength": 4,
          "pattern": "^[\\u0000-\\u00ff]{4}(?![\\s\\S])"
        },
        "encoding": {
          "const": "png; 8-bit RGBA; sRGB; lossless; native size; not rotated"
        },
        "display_at_start": {
          "$ref": "#/$defs/MacDisplayAtStart"
        },
        "host_clock": {
          "$ref": "#/$defs/MacHostClock"
        },
        "sample": {
          "$ref": "#/$defs/MacSampleFacts"
        }
      },
      "required": [
        "kind",
        "native_session_id",
        "pixel_format",
        "encoding",
        "display_at_start",
        "host_clock",
        "sample"
      ]
    },
    "DesktopTiming": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "observed_at_estimate": {
              "type": "null"
            },
            "estimate_basis": {
              "type": "null"
            },
            "uncertainty_ms": {
              "type": "null"
            },
            "callback_clock": {
              "type": "null"
            }
          },
          "required": [
            "observed_at_estimate",
            "estimate_basis",
            "uncertainty_ms",
            "callback_clock"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "observed_at_estimate": {
              "$ref": "#/$defs/CallbackEstimateUtc"
            },
            "estimate_basis": {
              "const": "session_wall_plus_callback_monotonic_delta"
            },
            "uncertainty_ms": {
              "type": "null"
            },
            "callback_clock": {
              "type": "null"
            }
          },
          "required": [
            "observed_at_estimate",
            "estimate_basis",
            "uncertainty_ms",
            "callback_clock"
          ]
        }
      ]
    },
    "DesktopFrame": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "0.2.7"
        },
        "kind": {
          "const": "raw_capture_frame"
        },
        "frame_id": {
          "$ref": "#/$defs/Identifier"
        },
        "device_id": {
          "$ref": "#/$defs/Identifier"
        },
        "session_id": {
          "$ref": "#/$defs/Identifier"
        },
        "stream_id": {
          "$ref": "#/$defs/Identifier"
        },
        "source": {
          "$ref": "#/$defs/SourceRef"
        },
        "artifact": {
          "$ref": "#/$defs/PngArtifactReference"
        },
        "raw_width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "raw_height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "callback_sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "captured_at": {
          "type": "null"
        },
        "media_position": {
          "type": "null"
        },
        "pixel_orientation": {
          "type": "null"
        },
        "pixels_transformed": {
          "type": "boolean",
          "const": false
        },
        "timing": {
          "$ref": "#/$defs/DesktopTiming"
        },
        "profile": {
          "$ref": "#/$defs/MacScreenCaptureKit"
        }
      },
      "required": [
        "contract_version",
        "kind",
        "frame_id",
        "device_id",
        "session_id",
        "stream_id",
        "source",
        "artifact",
        "raw_width",
        "raw_height",
        "callback_sequence",
        "captured_at",
        "media_position",
        "pixel_orientation",
        "pixels_transformed",
        "timing",
        "profile"
      ]
    }
  }
}
