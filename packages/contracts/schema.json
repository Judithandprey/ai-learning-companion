{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learning-companion.invalid/contracts/0.1.0/schema.json",
  "title": "Learning Companion P0 shared contracts",
  "description": "Named definitions, validate through a chosen $defs entry. Not a full application implementation.",
  "$defs": {
    "Identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*(?![\\s\\S])"
    },
    "UtcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z(?![\\s\\S])"
    },
    "SourceRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "user_id": {
          "$ref": "#/$defs/Identifier"
        },
        "source_id": {
          "$ref": "#/$defs/Identifier"
        },
        "source_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "user_id",
        "source_id",
        "source_version"
      ]
    },
    "AccessStatus": {
      "enum": [
        "registered",
        "fetched",
        "parsed",
        "indexed",
        "ready",
        "needs_auth",
        "temporarily_unavailable",
        "unsupported",
        "failed"
      ]
    },
    "Provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "origin": {
          "enum": [
            "synthetic",
            "user_authorized",
            "public_licensed"
          ]
        },
        "consent_scope": {
          "enum": [
            "test_only",
            "learning"
          ]
        },
        "attribution": {
          "type": "string",
          "minLength": 1
        },
        "license": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "origin",
        "consent_scope",
        "attribution",
        "license"
      ]
    },
    "LearningProject": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "user_id": {
          "$ref": "#/$defs/Identifier"
        },
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "kind": {
          "enum": [
            "course",
            "self_study",
            "work_learning"
          ]
        },
        "title": {
          "type": "string"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "goal_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "uniqueItems": true
        },
        "source_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "uniqueItems": true
        },
        "unit_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "uniqueItems": true
        },
        "status": {
          "enum": [
            "active",
            "paused",
            "archived"
          ]
        },
        "curriculum_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "user_id",
        "id",
        "kind",
        "title",
        "aliases",
        "goal_ids",
        "source_ids",
        "unit_ids",
        "status",
        "curriculum_version"
      ]
    },
    "SourceSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "user_id": {
          "$ref": "#/$defs/Identifier"
        },
        "source_id": {
          "$ref": "#/$defs/Identifier"
        },
        "source_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "project_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "type": {
          "enum": [
            "web",
            "transcript",
            "image",
            "document",
            "synthetic"
          ]
        },
        "original_url": {
          "type": "string",
          "format": "uri"
        },
        "canonical_url": {
          "type": "string",
          "format": "uri"
        },
        "connection_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "access_status": {
          "$ref": "#/$defs/AccessStatus"
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        },
        "fetched_at": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "source_timezone": {
          "type": "string",
          "format": "iana-timezone"
        },
        "locator_schema": {
          "const": "source-frame-v1"
        },
        "text": {
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        }
      },
      "required": [
        "user_id",
        "source_id",
        "source_version",
        "project_id",
        "type",
        "original_url",
        "canonical_url",
        "connection_id",
        "access_status",
        "content_hash",
        "fetched_at",
        "source_timezone",
        "locator_schema",
        "text",
        "provenance"
      ]
    },
    "Frame": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "user_id": {
          "$ref": "#/$defs/Identifier"
        },
        "source_id": {
          "$ref": "#/$defs/Identifier"
        },
        "source_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "frame_id": {
          "$ref": "#/$defs/Identifier"
        },
        "session_id": {
          "$ref": "#/$defs/Identifier"
        },
        "device_id": {
          "$ref": "#/$defs/Identifier"
        },
        "captured_at": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "source_timezone": {
          "type": "string",
          "format": "iana-timezone"
        },
        "media_position": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "artifact_id": {
          "$ref": "#/$defs/Identifier"
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        },
        "representation": {
          "enum": [
            "screen_capture",
            "dom_snapshot",
            "synthetic_fixture"
          ]
        }
      },
      "required": [
        "user_id",
        "source_id",
        "source_version",
        "frame_id",
        "session_id",
        "device_id",
        "captured_at",
        "source_timezone",
        "media_position",
        "width",
        "height",
        "artifact_id",
        "content_hash",
        "representation"
      ]
    },
    "Observation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "user_id": {
          "$ref": "#/$defs/Identifier"
        },
        "source_id": {
          "$ref": "#/$defs/Identifier"
        },
        "source_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "event_id": {
          "$ref": "#/$defs/Identifier"
        },
        "device_id": {
          "$ref": "#/$defs/Identifier"
        },
        "device_sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "session_id": {
          "$ref": "#/$defs/Identifier"
        },
        "captured_at": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "received_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/UtcTimestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_timezone": {
          "type": "string",
          "format": "iana-timezone"
        },
        "actor": {
          "enum": [
            "user",
            "teacher",
            "assistant",
            "unknown"
          ]
        },
        "text": {
          "type": "string"
        },
        "frame_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "media_position": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "gap_flags": {
          "type": "array",
          "items": {
            "enum": [
              "missing_audio",
              "missing_frame",
              "uncertain_transcript",
              "stale_frame"
            ]
          },
          "uniqueItems": true
        },
        "correction_of": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "user_id",
        "source_id",
        "source_version",
        "event_id",
        "device_id",
        "device_sequence",
        "session_id",
        "captured_at",
        "received_at",
        "source_timezone",
        "actor",
        "text",
        "frame_id",
        "media_position",
        "confidence",
        "gap_flags",
        "correction_of"
      ]
    },
    "Point": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "x",
        "y"
      ]
    },
    "BoundingBox": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ]
    },
    "Selection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "user_id": {
          "$ref": "#/$defs/Identifier"
        },
        "source_id": {
          "$ref": "#/$defs/Identifier"
        },
        "source_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "session_id": {
          "$ref": "#/$defs/Identifier"
        },
        "device_id": {
          "$ref": "#/$defs/Identifier"
        },
        "frame_id": {
          "$ref": "#/$defs/Identifier"
        },
        "media_position": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "bbox": {
          "$ref": "#/$defs/BoundingBox"
        },
        "polygon": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Point"
          },
          "minItems": 3
        },
        "selected_text": {
          "type": "string"
        },
        "concept_candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "uniqueItems": true
        },
        "input_mode": {
          "enum": [
            "pencil_ask",
            "explicit_touch_ask",
            "explicit_text_ask"
          ]
        },
        "created_at": {
          "$ref": "#/$defs/UtcTimestamp"
        }
      },
      "required": [
        "user_id",
        "source_id",
        "source_version",
        "id",
        "session_id",
        "device_id",
        "frame_id",
        "media_position",
        "bbox",
        "selected_text",
        "concept_candidates",
        "input_mode",
        "created_at"
      ]
    },
    "NoteBlock": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "layer": {
          "enum": [
            "user_original",
            "ai_supplement"
          ]
        },
        "format": {
          "enum": [
            "text",
            "markdown",
            "image"
          ]
        },
        "content": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "layer",
        "format",
        "content"
      ]
    },
    "ContextSegment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "$ref": "#/$defs/Identifier"
        },
        "source_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "frame_id": {
          "$ref": "#/$defs/Identifier"
        },
        "media_position": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "source_event_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "source_id",
        "source_version",
        "frame_id",
        "media_position",
        "source_event_ids"
      ]
    },
    "NoteRevision": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "user_id": {
          "$ref": "#/$defs/Identifier"
        },
        "note_id": {
          "$ref": "#/$defs/Identifier"
        },
        "kind": {
          "enum": [
            "ai",
            "handwritten"
          ]
        },
        "project_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "concept_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "uniqueItems": true
        },
        "title": {
          "type": "string"
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NoteBlock"
          }
        },
        "ink_blob_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "context_segments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ContextSegment"
          },
          "minItems": 1
        },
        "source_event_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "base_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "authorship": {
          "enum": [
            "user",
            "assistant"
          ]
        },
        "created_at": {
          "$ref": "#/$defs/UtcTimestamp"
        }
      },
      "required": [
        "user_id",
        "note_id",
        "kind",
        "project_id",
        "concept_ids",
        "title",
        "blocks",
        "ink_blob_id",
        "context_segments",
        "source_event_ids",
        "revision",
        "base_revision",
        "authorship",
        "created_at"
      ]
    },
    "EventBatch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "0.1.0"
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Observation"
          },
          "minItems": 1,
          "maxItems": 100
        }
      },
      "required": [
        "contract_version",
        "events"
      ]
    },
    "EventAck": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "$ref": "#/$defs/Identifier"
        },
        "device_id": {
          "$ref": "#/$defs/Identifier"
        },
        "device_sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "status": {
          "enum": [
            "accepted",
            "duplicate"
          ]
        }
      },
      "required": [
        "event_id",
        "device_id",
        "device_sequence",
        "status"
      ]
    },
    "EventBatchAck": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "0.1.0"
        },
        "acknowledged": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EventAck"
          }
        }
      },
      "required": [
        "contract_version",
        "acknowledged"
      ]
    },
    "AuthorizationContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "user_id": {
          "$ref": "#/$defs/Identifier"
        },
        "session_id": {
          "$ref": "#/$defs/Identifier"
        },
        "device_id": {
          "$ref": "#/$defs/Identifier"
        },
        "scopes": {
          "type": "array",
          "items": {
            "enum": [
              "sources:read",
              "events:write",
              "notes:read",
              "notes:write",
              "explanations:create",
              "sources:write",
              "jobs:cancel",
              "usage:read"
            ]
          },
          "uniqueItems": true
        },
        "expires_at": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "authorized_origin": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "user_id",
        "session_id",
        "device_id",
        "scopes",
        "expires_at",
        "authorized_origin"
      ]
    },
    "BudgetReservation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "user_id": {
          "$ref": "#/$defs/Identifier"
        },
        "reservation_id": {
          "$ref": "#/$defs/Identifier"
        },
        "request_id": {
          "$ref": "#/$defs/Identifier"
        },
        "backend": {
          "type": "string"
        },
        "budget_month": {
          "type": "string",
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])(?![\\s\\S])"
        },
        "budget_timezone": {
          "type": "string",
          "format": "iana-timezone"
        },
        "price_version": {
          "type": "string",
          "minLength": 1
        },
        "fx_version": {
          "type": "string",
          "minLength": 1
        },
        "currency": {
          "const": "CNY"
        },
        "estimated_max_fen": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "actual_fen": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "enum": [
            "reserved",
            "settled",
            "released"
          ]
        },
        "created_at": {
          "$ref": "#/$defs/UtcTimestamp"
        }
      },
      "required": [
        "user_id",
        "reservation_id",
        "request_id",
        "backend",
        "budget_month",
        "budget_timezone",
        "price_version",
        "fx_version",
        "currency",
        "estimated_max_fen",
        "actual_fen",
        "state",
        "created_at"
      ]
    },
    "ExplanationRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "user_id": {
          "$ref": "#/$defs/Identifier"
        },
        "request_id": {
          "$ref": "#/$defs/Identifier"
        },
        "selection_id": {
          "$ref": "#/$defs/Identifier"
        },
        "project_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "knowledge_profile_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "mode": {
          "const": "silent"
        }
      },
      "required": [
        "user_id",
        "request_id",
        "selection_id",
        "project_id",
        "knowledge_profile_version",
        "mode"
      ]
    },
    "ExplanationCard": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "user_id": {
          "$ref": "#/$defs/Identifier"
        },
        "request_id": {
          "$ref": "#/$defs/Identifier"
        },
        "selection_id": {
          "$ref": "#/$defs/Identifier"
        },
        "status": {
          "enum": [
            "ready",
            "generating",
            "needs_auth",
            "unsupported",
            "failed"
          ]
        },
        "cache_hit": {
          "type": "boolean"
        },
        "text": {
          "type": "string"
        },
        "source_event_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "uniqueItems": true
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceRef"
          }
        },
        "knowledge_profile_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "provenance": {
          "enum": [
            "fixture",
            "model",
            "none"
          ]
        },
        "audio": {
          "const": false
        }
      },
      "required": [
        "user_id",
        "request_id",
        "selection_id",
        "status",
        "cache_hit",
        "text",
