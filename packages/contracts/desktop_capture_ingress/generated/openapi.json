            "type": "number",
            "minimum": 0
          },
          "display_time_ticks_decimal": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/UInt64Decimal"
              },
              {
                "type": "null"
              }
            ]
          },
          "display_time_seconds": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          }
        },
        "required": [
          "basis",
          "session_started_wall_utc",
          "session_started_seconds",
          "callback_seconds",
          "display_time_ticks_decimal",
          "display_time_seconds"
        ]
      },
      "MacSampleFacts": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": {
            "const": "complete"
          },
          "presentation_time_seconds": {
            "type": [
              "number",
              "null"
