                }
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "status",
          "presentation_time_seconds",
          "geometry_basis",
          "geometry_unit",
          "content_rect",
          "content_scale",
          "scale_factor",
          "dirty_rects"
        ]
      },
