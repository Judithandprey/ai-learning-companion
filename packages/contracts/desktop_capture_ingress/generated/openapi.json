      "IdempotencyKey": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}(?![\\s\\S])",
        "minLength": 1,
        "maxLength": 128
      },
      "PngArtifactReference": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "artifact_id": {
            "$ref": "#/components/schemas/Identifier"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
          },
          "byte_length": {
            "type": "integer",
            "minimum": 1,
            "maximum": 33554432
          },
          "media_type": {
            "const": "image/png"
          }
        },
        "required": [
          "artifact_id",
          "sha256",
          "byte_length",
          "media_type"
        ]
      },
      "NativeWallUtc": {
        "type": "string",
        "format": "date-time",
        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,3})?Z(?![\\s\\S])"
      },
      "CallbackEstimateUtc": {
        "type": "string",
        "format": "date-time",
        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z(?![\\s\\S])"
      },
      "UInt64Decimal": {
        "type": "string",
        "minLength": 1,
        "maxLength": 20,
        "pattern": "^(?:0|[1-9][0-9]{0,18}|18446744073709551615|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4][0-9]{0})(?![\\s\\S])"
      },
      "ReportedRect": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "width": {
            "type": "number",
            "minimum": 0
          },
          "height": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "x",
          "y",
          "width",
          "height"
        ]
      },
      "MacDisplayAtStart": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "display_id": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "name": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1024
          },
          "frame_points": {
            "$ref": "#/components/schemas/ReportedRect"
          },
          "point_pixel_scale": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "requested_width_pixels": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "requested_height_pixels": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "rotation_degrees": {
            "type": "number"
          },
          "is_main": {
            "type": "boolean"
          },
          "scope": {
            "enum": [
              "whole display; no window excluded, so this app's windows are captured when visible; cursor shown; BGRA buffers requested in sRGB; no audio",
              "whole display; no window excluded, so this app's windows are captured when visible; cursor hidden; BGRA buffers requested in sRGB; no audio",
              "synthetic fixture; not a captured display"
            ]
          }
        },
        "required": [
          "display_id",
          "name",
          "frame_points",
          "point_pixel_scale",
          "requested_width_pixels",
          "requested_height_pixels",
          "rotation_degrees",
          "is_main",
          "scope"
        ]
      },
