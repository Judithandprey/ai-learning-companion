{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learning-companion.invalid/contracts/capture-ingress/0.2.4",
  "$defs": {
    "ProcessVersion": {
      "const": "0.2.0"
    },
    "ArtifactReference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/Identifier"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        },
        "byte_length": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "media_type": {
          "enum": [
            "image/png",
            "image/jpeg",
            "image/svg+xml",
            "application/json",
            "text/plain"
          ]
        }
      },
      "required": [
        "artifact_id",
        "sha256",
        "byte_length",
        "media_type"
      ]
    },
    "ProvisionalScope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "provisional_session"
        }
      },
      "required": [
        "kind"
      ]
    },
    "AttemptScope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "attempt"
        },
        "problem_id": {
          "$ref": "#/$defs/Identifier"
        },
        "attempt_id": {
          "$ref": "#/$defs/Identifier"
        },
        "relation_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "kind",
        "problem_id",
        "attempt_id",
        "relation_revision"
      ]
    },
    "ProcessScope": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProvisionalScope"
        },
        {
          "$ref": "#/$defs/AttemptScope"
        }
      ]
    },
    "CaptureClock": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "domain_id": {
          "$ref": "#/$defs/Identifier"
        },
        "elapsed_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "uncertainty_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "domain_id",
        "elapsed_ms",
        "uncertainty_ms"
      ]
    },
    "UnknownState": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "unknown"
        },
        "reason": {
          "enum": [
            "not_observed",
            "ambiguous",
            "unavailable"
          ]
        }
      },
      "required": [
        "kind",
        "reason"
      ]
    },
    "TextState": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "text"
        },
        "text": {
          "type": "string",
          "maxLength": 100000
        }
      },
      "required": [
        "kind",
        "text"
      ]
    },
    "ChoiceState": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "choices"
        },
        "selected_option_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "uniqueItems": true,
          "maxItems": 100
        }
      },
      "required": [
        "kind",
        "selected_option_ids"
      ]
    },
    "ArtifactState": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "artifact"
        },
        "artifact_id": {
          "$ref": "#/$defs/Identifier"
        }
      },
      "required": [
        "kind",
        "artifact_id"
      ]
    },
    "ObservedState": {
      "anyOf": [
        {
          "$ref": "#/$defs/UnknownState"
        },
        {
          "$ref": "#/$defs/TextState"
        },
        {
          "$ref": "#/$defs/ChoiceState"
        },
        {
          "$ref": "#/$defs/ArtifactState"
        }
      ]
    },
    "OperationEvidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "operation"
        },
        "operation": {
          "enum": [
            "select",
            "deselect",
            "reselect",
            "text_edit",
            "ink_edit",
            "erase",
            "undo",
            "redo",
            "visible_change",
            "site_feedback"
          ]
        },
        "observed_actor": {
          "enum": [
            "user",
            "website",
            "ai",
            "unknown"
          ]
        },
        "actor_basis": {
          "enum": [
            "trusted_input_event",
            "script_observation",
            "visual_observation",
            "user_report",
            "unknown"
          ]
        },
        "before": {
          "$ref": "#/$defs/ObservedState"
        },
        "after": {
          "$ref": "#/$defs/ObservedState"
        },
        "reason_quote": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 10000
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "operation",
        "observed_actor",
        "actor_basis",
        "before",
        "after",
        "reason_quote"
      ]
    },
    "SequenceInterval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "first": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "last": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "first",
        "last"
      ]
    },
    "CoverageEvidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "coverage"
        },
        "coverage": {
          "enum": [
            "observed_samples",
            "partial",
            "unobserved",
            "unknown"
          ]
        },
        "from_clock_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "through_clock_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "missing_sequences": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SequenceInterval"
          },
          "maxItems": 100
        },
        "limitations": {
          "type": "array",
          "items": {
            "enum": [
              "sample_only",
              "disconnected",
              "missing_events",
              "blurred",
              "occluded",
              "unsupported_history",
              "unknown"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "kind",
        "coverage",
        "from_clock_ms",
        "through_clock_ms",
        "missing_sequences",
        "limitations"
      ]
    },
    "ProcessRecord": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "record_id": {
          "$ref": "#/$defs/Identifier"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "source": {
          "$ref": "#/$defs/SourceRef"
        },
        "scope": {
          "$ref": "#/$defs/ProcessScope"
        },
        "observed_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/UtcTimestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "clock": {
          "anyOf": [
            {
              "$ref": "#/$defs/CaptureClock"
            },
            {
              "type": "null"
            }
          ]
        },
        "media_position": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "surface": {
          "enum": [
            "web_dom",
            "web_canvas",
            "external_app",
            "original_screen_overlay",
            "owned_canvas",
            "frozen_capture",
            "side_by_side"
          ]
        },
        "method": {
          "enum": [
            "structured",
            "visual",
            "mixed"
          ]
        },
        "causal_parents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "uniqueItems": true,
          "maxItems": 100
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ArtifactReference"
          },
          "maxItems": 100
        },
        "evidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/OperationEvidence"
            },
            {
              "$ref": "#/$defs/CoverageEvidence"
            }
          ]
        },
        "frame_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "record_id",
        "sequence",
        "source",
        "scope",
        "observed_at",
        "clock",
        "media_position",
        "surface",
        "method",
        "causal_parents",
        "artifacts",
        "evidence",
        "frame_id"
      ]
    },
    "ProcessBatch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "$ref": "#/$defs/ProcessVersion"
        },
        "batch_id": {
          "$ref": "#/$defs/Identifier"
        },
        "device_id": {
          "$ref": "#/$defs/Identifier"
        },
        "session_id": {
          "$ref": "#/$defs/Identifier"
        },
        "stream_id": {
          "$ref": "#/$defs/Identifier"
        },
        "delivery_mode": {
          "enum": [
            "live",
            "historical"
          ]
        },
        "records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProcessRecord"
          },
          "minItems": 1,
          "maxItems": 100
        }
      },
      "required": [
        "contract_version",
        "batch_id",
        "device_id",
        "session_id",
        "stream_id",
        "delivery_mode",
        "records"
      ]
    },
    "ArtifactReceipt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/Identifier"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        },
        "byte_length": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "media_type": {
          "enum": [
            "image/png",
            "image/jpeg",
            "image/svg+xml",
            "application/json",
            "text/plain"
          ]
        },
        "status": {
          "enum": [
            "pending",
            "verified"
          ]
        }
      },
      "required": [
        "artifact_id",
        "sha256",
        "byte_length",
        "media_type",
        "status"
      ]
    },
    "ProcessReceipt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "record_id": {
          "$ref": "#/$defs/Identifier"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "disposition": {
          "enum": [
            "accepted",
            "duplicate"
          ]
        },
        "received_at": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "envelope": {
          "const": "committed"
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ArtifactReceipt"
          },
          "maxItems": 100
        }
      },
      "required": [
        "record_id",
        "sequence",
        "disposition",
        "received_at",
        "envelope",
        "artifacts"
      ]
    },
    "ProcessBatchAck": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "$ref": "#/$defs/ProcessVersion"
        },
        "batch_id": {
          "$ref": "#/$defs/Identifier"
        },
        "user_id": {
          "$ref": "#/$defs/Identifier"
        },
        "device_id": {
          "$ref": "#/$defs/Identifier"
        },
        "session_id": {
          "$ref": "#/$defs/Identifier"
        },
        "stream_id": {
          "$ref": "#/$defs/Identifier"
        },
        "acknowledged": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProcessReceipt"
          },
          "minItems": 1,
          "maxItems": 100
        }
      },
      "required": [
        "contract_version",
        "batch_id",
        "user_id",
        "device_id",
        "session_id",
        "stream_id",
        "acknowledged"
      ]
    },
    "ProcessError": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "$ref": "#/$defs/ProcessVersion"
        },
        "error": {
          "enum": [
            "unauthenticated",
            "forbidden",
            "capability_required",
            "not_found",
            "record_conflict",
            "idempotency_conflict",
            "dependency_missing",
            "stale_scope",
            "capture_stopped",
            "unsupported_version",
            "invalid_request",
            "unavailable"
          ]
        },
        "request_id": {
          "$ref": "#/$defs/Identifier"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "contract_version",
        "error",
        "request_id",
        "retryable"
      ]
    },
    "Identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*(?![\\s\\S])"
    },
    "UtcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z(?![\\s\\S])"
    },
    "SourceRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "user_id": {
          "$ref": "#/$defs/Identifier"
        },
        "source_id": {
          "$ref": "#/$defs/Identifier"
        },
        "source_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "user_id",
        "source_id",
        "source_version"
      ]
    },
    "IdempotencyKey": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}(?![\\s\\S])",
      "minLength": 1,
      "maxLength": 128
    },
    "Frame": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "user_id": {
          "$ref": "#/$defs/Identifier"
        },
        "source_id": {
          "$ref": "#/$defs/Identifier"
        },
        "source_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "frame_id": {
          "$ref": "#/$defs/Identifier"
        },
        "session_id": {
          "$ref": "#/$defs/Identifier"
        },
        "device_id": {
          "$ref": "#/$defs/Identifier"
        },
        "captured_at": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "source_timezone": {
          "type": "string",
          "format": "iana-timezone"
        },
        "media_position": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "artifact_id": {
          "$ref": "#/$defs/Identifier"
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        },
        "representation": {
          "enum": [
            "screen_capture",
            "dom_snapshot",
            "synthetic_fixture"
          ]
        }
      },
      "required": [
        "user_id",
        "source_id",
        "source_version",
        "frame_id",
        "session_id",
        "device_id",
        "captured_at",
        "source_timezone",
        "media_position",
        "width",
        "height",
        "artifact_id",
        "content_hash",
        "representation"
      ]
    },
    "OriginalArtifactBinding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "0.2.2"
        },
        "source": {
          "$ref": "#/$defs/SourceRef"
        },
        "artifact": {
          "$ref": "#/$defs/ArtifactReference"
        },
        "kind": {
          "enum": [
            "screen_image",
            "editable_ink"
          ]
        }
      },
      "required": [
        "contract_version",
        "source",
        "artifact",
        "kind"
      ]
    },
    "OriginalArtifactUpload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "0.2.2"
        },
        "source": {
          "$ref": "#/$defs/SourceRef"
        },
        "artifact": {
          "$ref": "#/$defs/ArtifactReference"
        },
        "kind": {
          "enum": [
            "screen_image",
            "editable_ink"
          ]
        },
        "data_base64": {
          "type": "string",
          "minLength": 4,
          "maxLength": 44739244
        }
      },
      "required": [
        "contract_version",
        "source",
        "artifact",
        "kind",
        "data_base64"
      ]
    },
    "OriginalArtifactReceipt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "0.2.2"
        },
        "source": {
          "$ref": "#/$defs/SourceRef"
        },
        "artifact": {
          "$ref": "#/$defs/ArtifactReference"
        },
        "kind": {
          "enum": [
            "screen_image",
            "editable_ink"
          ]
        },
        "status": {
          "const": "bytes_committed"
        }
      },
      "required": [
        "contract_version",
        "source",
        "artifact",
        "kind",
        "status"
      ]
    },
    "DisplaySourceSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "0.2.3"
        },
        "user_id": {
          "$ref": "#/$defs/Identifier"
        },
        "source_id": {
          "$ref": "#/$defs/Identifier"
        },
        "source_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "type": {
          "const": "shared_display"
        },
        "device_id": {
          "$ref": "#/$defs/Identifier"
        },
        "session_id": {
          "$ref": "#/$defs/Identifier"
        },
        "stream_id": {
          "$ref": "#/$defs/Identifier"
        },
        "project_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "created_at": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "source_timezone": {
          "type": "string",
          "format": "iana-timezone"
        }
      },
      "required": [
        "contract_version",
        "user_id",
        "source_id",
        "source_version",
        "type",
        "device_id",
        "session_id",
        "stream_id",
        "project_id",
        "created_at",
        "source_timezone"
      ]
    },
    "SourceVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "DisplaySourceRegistration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "0.2.4"
        },
        "source_id": {
          "$ref": "#/$defs/Identifier"
        },
        "stream_id": {
          "$ref": "#/$defs/Identifier"
        },
        "project_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_timezone": {
          "type": "string",
          "format": "iana-timezone"
        }
      },
      "required": [
        "contract_version",
        "source_id",
        "stream_id",
        "project_id",
        "source_timezone"
      ]
    },
    "FrameBatchRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "0.2.4"
        },
        "batch": {
          "$ref": "#/$defs/ProcessBatch"
        },
        "frames": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/Frame"
          }
        }
      },
      "required": [
        "contract_version",
        "batch",
        "frames"
      ]
    },
    "IngressError": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "0.2.4"
        },
        "error": {
          "enum": [
            "invalid_json",
            "unauthenticated",
            "forbidden",
            "capability_required",
            "not_found",
            "source_identity_conflict",
            "record_conflict",
            "idempotency_conflict",
            "dependency_missing",
            "stale_scope",
            "capture_stopped",
            "unsupported_source",
            "payload_too_large",
            "unsupported_media_type",
            "unsupported_version",
            "invalid_request",
            "unavailable"
          ]
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "contract_version",
        "error",
        "retryable"
      ]
    }
  }
}
