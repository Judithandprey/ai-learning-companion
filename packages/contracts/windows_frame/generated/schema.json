{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learning-companion.invalid/contracts/windows-frame/0.2.9",
  "$ref": "#/$defs/WindowsFrame",
  "$defs": {
    "Identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*(?![\\s\\S])"
    },
    "UtcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z(?![\\s\\S])"
    },
    "SourceRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "user_id": {
          "$ref": "#/$defs/Identifier"
        },
        "source_id": {
          "$ref": "#/$defs/Identifier"
        },
        "source_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "user_id",
        "source_id",
        "source_version"
      ]
    },
    "PngArtifactReference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/Identifier"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        },
        "byte_length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 33554432
        },
        "media_type": {
          "const": "image/png"
        }
      },
      "required": [
        "artifact_id",
        "sha256",
        "byte_length",
        "media_type"
      ]
    },
    "Sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
    },
    "LocalWallUtc": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,3})?Z(?![\\s\\S])"
    },
    "DisplayAtStart": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "display"
        },
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "display_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "label": {
          "type": "string",
          "maxLength": 1024
        },
        "bounds": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "x": {
              "type": "number",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "y": {
              "type": "number",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "width": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "height": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "x",
            "y",
            "width",
            "height"
          ]
        },
        "scale_factor": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "kind",
        "source_id",
        "display_id",
        "label",
        "bounds",
        "scale_factor"
      ]
    },
    "WindowsSample": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sample_seq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "frame_seq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "reason": {
          "enum": [
            "first",
            "ink",
            "changed",
            "heartbeat",
            "deferred"
          ]
        },
        "deferred_samples_not_retained": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "uniqueItems": true
        },
        "sampled_at": {
          "$ref": "#/$defs/LocalWallUtc"
        },
        "taken_at": {
          "$ref": "#/$defs/LocalWallUtc"
        },
        "monotonic_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "state": {
          "enum": [
            "fresh",
            "no_new_frame",
            "gap"
          ]
        },
        "gap_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "presented_frames": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "stream_presented_frames": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "presentation_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "frame_age_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "change_from_previous_sample": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "sample_seq",
        "frame_seq",
        "reason",
        "deferred_samples_not_retained",
        "sampled_at",
        "taken_at",
        "monotonic_ms",
        "state",
        "gap_ms",
        "presented_frames",
        "stream_presented_frames",
        "presentation_ms",
        "frame_age_ms",
        "change_from_previous_sample"
      ]
    },
    "WindowsElectron": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "windows_electron"
        },
        "retention_format": {
          "const": "lc-desktop-capture-retention/v1"
        },
        "capture_session": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "started_at": {
          "$ref": "#/$defs/LocalWallUtc"
        },
        "source_at_start": {
          "$ref": "#/$defs/DisplayAtStart"
        },
        "sample": {
          "$ref": "#/$defs/WindowsSample"
        }
      },
      "required": [
        "kind",
        "retention_format",
        "capture_session",
        "started_at",
        "source_at_start",
        "sample"
      ]
    },
    "WindowsPng": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "$ref": "#/$defs/PngArtifactReference"
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "pixels_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "native_file": {
          "type": "string",
          "pattern": "^frames/[0-9a-f]{64}\\.png(?![\\s\\S])"
        }
      },
      "required": [
        "artifact",
        "width",
        "height",
        "pixels_sha256",
        "native_file"
      ]
    },
    "WindowsComposition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": {
          "$ref": "#/$defs/WindowsPng"
        },
        "ink_session": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "ink_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "visible_strokes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "ink_marks": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "verified": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "changed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "unknown": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "following_content": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "verified",
            "changed",
            "unknown",
            "following_content"
          ]
        },
        "transformation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [
        "image",
        "ink_session",
        "ink_revision",
        "visible_strokes",
        "ink_marks",
        "transformation"
      ]
    },
    "WindowsFrame": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "0.2.9"
        },
        "kind": {
          "const": "retained_capture_frame"
        },
        "frame_id": {
          "$ref": "#/$defs/Identifier"
        },
        "device_id": {
          "$ref": "#/$defs/Identifier"
        },
        "session_id": {
          "$ref": "#/$defs/Identifier"
        },
        "stream_id": {
          "$ref": "#/$defs/Identifier"
        },
        "source": {
          "$ref": "#/$defs/SourceRef"
        },
        "captured_at": {
          "type": "null"
        },
        "media_position": {
          "type": "null"
        },
        "capture_latency_ms": {
          "type": "null"
        },
        "raw": {
          "$ref": "#/$defs/WindowsPng"
        },
        "composed": {
          "anyOf": [
            {
              "$ref": "#/$defs/WindowsComposition"
            },
            {
              "type": "null"
            }
          ]
        },
        "profile": {
          "$ref": "#/$defs/WindowsElectron"
        }
      },
      "required": [
        "contract_version",
        "kind",
        "frame_id",
        "device_id",
        "session_id",
        "stream_id",
        "source",
        "captured_at",
        "media_position",
        "capture_latency_ms",
        "raw",
        "composed",
        "profile"
      ]
    }
  }
}
