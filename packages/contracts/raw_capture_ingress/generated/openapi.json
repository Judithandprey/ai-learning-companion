        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}(?![\\s\\S])",
        "minLength": 1,
        "maxLength": 128
      },
      "PngArtifactReference": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "artifact_id": {
            "$ref": "#/components/schemas/Identifier"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
          },
          "byte_length": {
            "type": "integer",
            "minimum": 1,
            "maximum": 33554432
          },
          "media_type": {
            "const": "image/png"
          }
        },
        "required": [
          "artifact_id",
          "sha256",
          "byte_length",
          "media_type"
        ]
      },
      "CallbackClock": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "domain_id": {
            "$ref": "#/components/schemas/Identifier"
          },
          "elapsed_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "uncertainty_ms": {
            "type": "null"
          }
        },
        "required": [
          "domain_id",
          "elapsed_ms",
          "uncertainty_ms"
        ]
      },
      "RawCaptureTiming": {
        "anyOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "observed_at_estimate": {
                "type": "null"
              },
              "estimate_basis": {
                "type": "null"
              },
              "uncertainty_ms": {
                "type": "null"
              },
              "callback_clock": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/CallbackClock"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "sample_pts_seconds": {
                "type": [
                  "number",
                  "null"
                ]
              }
            },
            "required": [
              "observed_at_estimate",
              "estimate_basis",
              "uncertainty_ms",
              "callback_clock",
              "sample_pts_seconds"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "observed_at_estimate": {
                "$ref": "#/components/schemas/UtcTimestamp"
              },
              "estimate_basis": {
                "const": "session_wall_plus_callback_monotonic_delta"
              },
              "uncertainty_ms": {
                "type": "null"
              },
              "callback_clock": {
                "$ref": "#/components/schemas/CallbackClock"
              },
              "sample_pts_seconds": {
                "type": [
                  "number",
                  "null"
                ]
              }
            },
            "required": [
              "observed_at_estimate",
              "estimate_basis",
              "uncertainty_ms",
              "callback_clock",
              "sample_pts_seconds"
            ]
          }
        ]
      },
      "RawCaptureOrientation": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "system": {
            "const": "CGImagePropertyOrientation"
          },
          "value": {
            "type": [
              "integer",
              "null"
            ],
            "enum": [
              null,
              1,
              2,
              3,
              4,
              5,
              6,
              7,
              8
            ]
          },
          "applied_to_pixels": {
            "type": "boolean",
            "const": false
          }
        },
        "required": [
          "system",
          "value",
          "applied_to_pixels"
        ]
      },
      "RawCaptureFrame": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "contract_version": {
            "const": "0.2.5"
          },
          "kind": {
            "const": "raw_capture_frame"
          },
          "frame_id": {
            "$ref": "#/components/schemas/Identifier"
          },
          "source": {
            "$ref": "#/components/schemas/SourceRef"
          },
          "device_id": {
            "$ref": "#/components/schemas/Identifier"
          },
          "session_id": {
            "$ref": "#/components/schemas/Identifier"
          },
          "stream_id": {
            "$ref": "#/components/schemas/Identifier"
          },
          "artifact": {
            "$ref": "#/components/schemas/PngArtifactReference"
          },
          "raw_width": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "raw_height": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "buffer_sequence": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "captured_at": {
            "type": "null"
          },
          "media_position": {
            "type": "null"
          },
          "timing": {
            "$ref": "#/components/schemas/RawCaptureTiming"
          },
          "orientation": {
            "$ref": "#/components/schemas/RawCaptureOrientation"
          }
        },
        "required": [
          "contract_version",
          "kind",
          "frame_id",
          "source",
          "device_id",
          "session_id",
          "stream_id",
          "artifact",
          "raw_width",
          "raw_height",
          "buffer_sequence",
          "captured_at",
          "media_position",
          "timing",
          "orientation"
        ]
      },
      "RawFrameBatchRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "contract_version": {
            "const": "0.2.6"
          },
          "batch": {
            "$ref": "#/components/schemas/ProcessBatch"
          },
          "frames": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/RawCaptureFrame"
            }
          }
        },
        "required": [
          "contract_version",
          "batch",
          "frames"
        ]
      },
      "RawIngressError": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "contract_version": {
            "const": "0.2.6"
