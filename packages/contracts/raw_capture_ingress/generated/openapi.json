            "enum": [
              "invalid_json",
              "unauthenticated",
              "forbidden",
              "capability_required",
              "not_found",
              "source_identity_conflict",
              "record_conflict",
              "idempotency_conflict",
              "dependency_missing",
              "stale_scope",
              "capture_stopped",
              "unsupported_source",
              "payload_too_large",
              "unsupported_media_type",
              "unsupported_version",
              "invalid_request",
              "unavailable"
            ]
          },
          "retryable": {
